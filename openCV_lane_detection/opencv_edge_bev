import cv2
import numpy as np

def grayscale(img):
    return cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)   # VideoCapture는 BGR


def region_of_interest(img, vertices):
    mask = np.zeros_like(img)
    ignore_mask_color = 255
    cv2.fillPoly(mask, vertices, ignore_mask_color)
    return cv2.bitwise_and(img, mask)

def draw_lines(img, lines, color=(0,0,255), thickness=5): 
    if lines is None: 
        return 
    for line in lines: 
        x1,y1,x2,y2 = line[0] 
        cv2.line(img, (x1,y1), (x2,y2), color, thickness)


def weighted_img(img, initial_img, a=0.8, b=1.0, c=0.0):
    return cv2.addWeighted(initial_img, a, img, b, c)

def bev_transform(img, src, dst, size):
    M = cv2.getPerspectiveTransform(src, dst)
    bev = cv2.warpPerspective(img, M, size, flags=cv2.INTER_LINEAR)
    return bev

def gaussian_blur(img, kernel_size):
    return cv2.GaussianBlur(img, (kernel_size, kernel_size), 1.5)

def canny(img, low_threshold, high_threshold):
    return cv2.Canny(img, low_threshold, high_threshold)

def hough_lines(img, rho, theta, threshold, min_line_len, max_line_gap):
    lines = cv2.HoughLinesP(
        img, rho, theta, threshold,
        minLineLength=min_line_len,
        maxLineGap=max_line_gap
    )
    line_img = np.zeros((img.shape[0], img.shape[1], 3), dtype=np.uint8)
    if lines is None:
        return line_img    

    filtered = []

    for l in lines:
        x1,y1,x2,y2 = l[0]
        dx = x2 - x1
        dy = y2 - y1
        if dx == 0:
            angle = 90
        else:
            angle = abs(np.degrees(np.arctan2(dy, dx)))  # 0=가로, 90=세로
        if angle > 40:   # 세로 성분 강한 것만
            filtered.append(l)

    if len(filtered) > 0:
        draw_lines(line_img, np.array(filtered), color=(0,0,255), thickness=5)
    return line_img

# ---- 영상 입력 ----
video_path = "curv.mp4"
cap = cv2.VideoCapture(video_path)
if not cap.isOpened():
    raise RuntimeError("비디오를 열 수 없음: " + video_path)

# (옵션) 저장 설정
save = False
writer = None

kernel_size = 5
low_threshold = 50
high_threshold = 200

rho = 2 #거리 해상도
theta = np.pi/180 #각도 해상도
threshold = 100 #몇 번 이상 투표를 받을지
min_line_len = 100 #이 길이보다 짧으면 버림
max_line_gap = 80 #하나로 이어붙여도 된다는 허용 간격

# ===== 저장부 수정 시작 (여기만 변경) =====
fps = cap.get(cv2.CAP_PROP_FPS)
if fps <= 0:
    fps = 30

fourcc = cv2.VideoWriter_fourcc(*"mp4v")
# ===== 저장부 수정 끝 =====

while True:
    ret, frame = cap.read()
    if not ret:
        break

    h, w = frame.shape[:2]
    src = np.float32([
    [0.2*w, 0.55*h],
    [0.8*w, 0.55*h],
    [0.95*w, 0.9*h],
    [0.05*w, 0.9*h]
    ])

    dst = np.float32([
        [0*w, 0],
        [1*w, 0],
        [1*w, h],
        [0*w, h]
    ])
    vertices = np.array([[
        (0, int(0.9*h)),
        (int(0*w), int(0.55*h)),
        (int(1*w), int(0.55*h)),
        (w, int(0.9*h))
    ]], dtype=np.int32)

    gray = grayscale(frame)
    bev_gray = bev_transform(gray, src, dst, (w, h))
    bev_color = bev_transform(frame, src, dst, (w, h))
    blur_gray = gaussian_blur(bev_gray, kernel_size)
    bev_edges = canny(blur_gray, low_threshold, high_threshold)
    cv2.imshow("BEV + edges", bev_edges)

    line_img = hough_lines(bev_edges, rho, theta, threshold,
                        min_line_len, max_line_gap)
    
    result = weighted_img(line_img, bev_color, a=0.8, b=1.0, c=0.0)
    cv2.imshow("Lane detection", result)


    if cv2.waitKey(5) & 0xFF == ord('q'):
        break


cap.release()
if writer is not None:
    writer.release()
cv2.destroyAllWindows()
